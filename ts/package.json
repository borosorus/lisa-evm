{
  "name": "@bosorus/lisa-evm",
  "version": "0.4.0",
  "description": "TypeScript SDK for the LISA stack VM: program builder, ABI calldata, AST, compiler, encoder, and disassembler for the LISA runtime",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borosorus/lisa-evm.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/borosorus/lisa-evm#readme",
  "bugs": {
    "url": "https://github.com/borosorus/lisa-evm/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "lisa",
    "stack-vm",
    "bytecode",
    "compiler",
    "disassembler",
    "abi",
    "evm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./isa": { "types": "./dist/isa.d.ts", "default": "./dist/isa.js" },
    "./bytes": { "types": "./dist/bytes.d.ts", "default": "./dist/bytes.js" },
    "./encode": { "types": "./dist/encode.d.ts", "default": "./dist/encode.js" },
    "./decode": { "types": "./dist/decode.d.ts", "default": "./dist/decode.js" },
    "./ast": { "types": "./dist/ast.d.ts", "default": "./dist/ast.js" },
    "./compile": { "types": "./dist/compile.d.ts", "default": "./dist/compile.js" },
    "./api": { "types": "./dist/api.d.ts", "default": "./dist/api.js" },
    "./expr": { "types": "./dist/expr.d.ts", "default": "./dist/expr.js" },
    "./abi": { "types": "./dist/abi.d.ts", "default": "./dist/abi.js" },
    "./builder": { "types": "./dist/builder.d.ts", "default": "./dist/builder.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "fixtures": "node tools/gen-runtime-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
